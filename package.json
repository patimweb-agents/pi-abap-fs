{
  "name": "@patimweb/pi-abap-fs",
  "version": "1.2.2",
  "description": "ABAP remote filesystem extension for pi coding agent. Read, search, write and activate ABAP objects on SAP systems via the ADT protocol.",
  "keywords": [
    "pi-package",
    "abap",
    "sap",
    "adt",
    "pi-extension"
  ],
  "author": "Patrick Weppelmann",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Smotherer007/pi-abap-fs.git"
  },
  "bugs": {
    "url": "https://github.com/Smotherer007/pi-abap-fs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "echo 'No build step defined'",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --test 'tests/**/*.test.ts'",
    "test:watch": "node --experimental-strip-types --experimental-test-module-mocks --test --watch 'tests/**/*.test.ts'"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/Smotherer007/pi-abap-fs/main/screenshot.png"
  },
  "dependencies": {
    "abap-adt-api": "^10.0.0"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^24.0.0",
    "semantic-release": "^25.0.9",
    "typebox": "^1.3.27",
    "typescript": "^5.8.0"
  }
}
